{
  "name": "thesanketkale/fixture-php",
  "description": "Synthetic PHP test fixture",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Fixture\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fixture\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
