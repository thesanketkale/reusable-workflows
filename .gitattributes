# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force scripts and workflow definitions to LF
scripts/verify.sh text eol=lf
.githooks/* text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.tf text eol=lf
*.cs text eol=lf
*.php text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
